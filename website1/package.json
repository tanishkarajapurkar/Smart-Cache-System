{
  "name": "apts-ecommerce",
  "version": "1.0.0",
  "type": "module",
  "description": "APTS E-Commerce Website & Workload Generator for CacheX",
  "scripts": {
    "cache-engine": "node ../Cache_Engine/cache-server.js",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "simulator": "npm run start --prefix traffic-simulator",
    "simulator:normal": "npm run normal --prefix traffic-simulator",
    "simulator:high": "npm run high --prefix traffic-simulator",
    "simulator:surge": "npm run surge --prefix traffic-simulator",
    "start:all": "bash start-all.sh",
    "build": "npm run build --prefix backend && npm run build --prefix frontend"
  },
  "keywords": [
    "apts-ecommerce",
    "cachex",
    "workload-generator",
    "traffic-simulator",
    "react",
    "express",
    "postgresql",
    "tailwind"
  ],
  "author": "",
  "license": "MIT"
}
